{
  "rules": {
    ".read": false,
    ".write": false,
    "studyhub": {
      ".read": true,
      ".write": false,
      "global_settings": {
        ".read": true,
        ".write": "newData.exists()"
      },
      "admins_list": {
        ".read": true,
        ".write": "newData.exists()"
      },
      "audit_logs": {
        ".read": true,
        ".write": "newData.exists()"
      },
      "studyhub_weekly_leaderboard": {
        ".read": true,
        ".write": "newData.exists()"
      },
      "leaderboard_players": {
        ".read": true,
