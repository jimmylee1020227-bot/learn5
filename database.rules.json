{
  "rules": {
    ".read": false,
    ".write": false,
    "studyhub": {
      ".read": false,
      ".write": false,

      "global_settings": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "admins_list": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "audit_logs": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "studyhub_weekly_leaderboard": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "leaderboard_players": {
        ".read": true,
        ".write": "newData.exists()",
        "$userId": {
          ".read": true,
          ".write": "newData.exists()"
        }
      },

      "ticket_grants": {
        ".read": true,
        ".write": "newData.exists()",
        "$userId": {
          ".read": true,
          ".write": "newData.exists()"
        }
      },

      "studyhub_hall_of_fame": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "recent_practice_stream": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "user_registry": {
        ".read": true,
        ".write": "newData.exists()",
        "$userId": {
          ".read": true,
          ".write": "newData.exists()"
        }
      },

      "admin_notifications": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "redemption_codes": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "question_overrides": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "question_reports": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "site_issue_reports": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "community_posts": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "deleted_community_post_ids": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "community_reports": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "support_chats": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "quiz_papers": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "all_quiz_papers": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "redeemed_ledger": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "deleted_notifications": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "deleted_redemption_codes": {
        ".read": true,
        ".write": "newData.exists()"
      },

      "$dynamicKey": {
        ".read": true,
        ".write": "newData.exists() && ($dynamicKey.matches('^practice_history_[a-zA-Z0-9@._-]+$') || $dynamicKey.matches('^mistake_notebook_[a-zA-Z0-9@._-]+$') || $dynamicKey.matches('^user_quiz_papers_[a-zA-Z0-9@._-]+$') || $dynamicKey.matches('^studyhub_game_state_[a-zA-Z0-9@._-]+$') || $dynamicKey.matches('^redeemed_history_[a-zA-Z0-9@._-]+$') || $dynamicKey.matches('^daily_stats_[a-zA-Z0-9@._-]+$') || $dynamicKey.matches('^privacy_consent_[a-zA-Z0-9@._-]+$') || $dynamicKey.matches('^studyhub_custom_name_[a-zA-Z0-9@._-]+$'))",
        "comment": "動態 key 白名單：支援包含 email 在內的所有合法用戶 ID"
      }
    }
  }
}
